// Writes the branch/extension MPT state proof fixture used by diesis-py's tests:
//   node test/helpers/generate-mpt-branch-fixture.mts OUTPUT.json
import { writeFileSync } from 'node:fs'
import { bytesToHex, hexToBytes, keccak256 } from 'viem'
// Node strips TypeScript types from the helper at runtime.
import { rlpInteger, rlpList, rlpString, secureTrie } from './mpt-trie.ts'
const word = (b: number) => bytesToHex(new Uint8Array(32).fill(b))
const EMPTY_ROOT =
  '0x56e81f171bcc55a6ff8345e692c0f86e5b48e01b996cadc001622fb5e363b421'
const EMPTY_CODE =
  '0xc5d2460186f7233c927e7db2dcc703c0e500b653ca82273b7bfad8045d85a470'
const header = (root: string, n: bigint) =>
  bytesToHex(
    rlpList([
      rlpString(hexToBytes(word(1))),
      rlpString(hexToBytes(word(2))),
      rlpString(new Uint8Array(20)),
      rlpString(hexToBytes(root)),
      rlpString(hexToBytes(EMPTY_ROOT)),
      rlpString(hexToBytes(EMPTY_ROOT)),
      rlpString(new Uint8Array(256)),
      rlpInteger(0n),
      rlpInteger(n),
      rlpInteger(30000000n),
      rlpInteger(0n),
      rlpInteger(1700000000n),
      rlpString(new Uint8Array()),
      rlpString(hexToBytes(word(3))),
      rlpString(new Uint8Array(8)),
      rlpInteger(7n),
    ]),
  )
const account = (nonce: bigint, bal: bigint, sr: string, ch: string) =>
  rlpList([
    rlpInteger(nonce),
    rlpInteger(bal),
    rlpString(hexToBytes(sr)),
    rlpString(hexToBytes(ch)),
  ])
const target = '0x' + '11'.repeat(20)
const slots = [word(3), word(4), word(5), word(6)]
const values = [5n, 6n, 1n << 200n, 0xffn]
const storage = slots.map((key, i) => ({ key, value: rlpInteger(values[i]) }))
const storageRoot = secureTrie(storage).root
const codeHash = keccak256('0x6000')
const accounts = [
  ...Array.from({ length: 40 }, (_, i) => ({
    key: bytesToHex(new Uint8Array(20).fill(i + 0x20)),
    value: account(BigInt(i), BigInt(i) * 10n ** 18n, EMPTY_ROOT, EMPTY_CODE),
  })),
  { key: target, value: account(7n, 8n, storageRoot, codeHash) },
]
const root = secureTrie(accounts).root
const canonicalHeader = header(root, 9n)
const blockHash = keccak256(canonicalHeader)
const build = (address: string, keys: string[]) => {
  const present = address === target
  return {
    request: { blockNumber: '0x9', address, storageKeys: keys },
    response: {
      schemaVersion: 2,
      blockHash,
      stateRoot: root,
      canonicalHeader,
      checkpoint: '0x4d50513700',
      proof: {
        address,
        nonce: present ? '0x7' : '0x0',
        balance: present ? '0x8' : '0x0',
        codeHash: present ? codeHash : EMPTY_CODE,
        storageHash: present ? storageRoot : EMPTY_ROOT,
        accountProof: secureTrie(accounts, address).proof,
        storageProof: keys.map((key) => {
          const i = slots.indexOf(key)
          return {
            key,
            value: present && i >= 0 ? '0x' + values[i].toString(16) : '0x0',
            proof: present ? secureTrie(storage, key).proof : [],
          }
        }),
      },
    },
  }
}
const fixture = {
  source:
    'Generated by diesis-js test/helpers/generate-mpt-branch-fixture.mts with its test trie builder: 41 accounts and 4 storage slots, with branch, extension and hashed nodes on both paths',
  blockHash,
  present: {
    ...build(target, [slots[2], word(0), slots[0]]),
    expected: {
      nonce: '7',
      balance: '8',
      codeHash,
      storageRoot,
      storage: [
        '1606938044258990275541962092341162602522202993782792835301376',
        '0',
        '5',
      ],
    },
  },
  missing: build('0x' + '99'.repeat(20), [slots[0]]),
}
writeFileSync(process.argv[2], JSON.stringify(fixture, null, 2) + '\n')
