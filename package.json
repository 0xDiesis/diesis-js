{
  "name": "@diesis/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Diesis chain — viem extension with exchange, intents, bundles, and patronage",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./chains": {
      "import": "./dist/chains.js",
      "types": "./dist/chains.d.ts"
    },
    "./addresses": {
      "import": "./dist/addresses.js",
      "types": "./dist/addresses.d.ts"
    },
    "./names": {
      "import": "./dist/names.js",
      "types": "./dist/names.d.ts"
    },
    "./staking": {
      "import": "./dist/staking/actions.js",
      "types": "./dist/staking/actions.d.ts"
    },
    "./exchange": {
      "import": "./dist/exchange/index.js",
      "types": "./dist/exchange/index.d.ts"
    },
    "./intents": {
      "import": "./dist/intents/index.js",
      "types": "./dist/intents/index.d.ts"
    },
    "./bundles": {
      "import": "./dist/bundles/index.js",
      "types": "./dist/bundles/index.d.ts"
    },
    "./patronage": {
      "import": "./dist/patronage/index.js",
      "types": "./dist/patronage/index.d.ts"
    },
    "./privacy": {
      "import": "./dist/privacy/index.js",
      "types": "./dist/privacy/index.d.ts"
    },
    "./abi": {
      "import": "./dist/abi/index.js",
      "types": "./dist/abi/index.d.ts"
    },
    "./abi/wagmi": {
      "import": "./dist/abi/generated/wagmi/index.js",
      "types": "./dist/abi/generated/wagmi/index.d.ts"
    },
    "./abi/ethers": {
      "import": "./dist/abi/generated/ethers/index.js",
      "types": "./dist/abi/generated/ethers/index.d.ts"
    },
    "./abi/web3js": {
      "import": "./dist/abi/generated/web3js/index.js",
      "types": "./dist/abi/generated/web3js/index.d.ts"
    }
  },
  "scripts": {
    "codegen": "pnpm --dir ../diesis/contracts abi:generate",
    "build": "tsc",
    "clean": "rm -rf dist",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.json\" \"*.md\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "quality": "pnpm run lint && pnpm run typecheck && pnpm run format:check",
    "quality:fix": "pnpm run lint:fix && pnpm run format && pnpm run typecheck",
    "prepare": "pnpm run build",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "keywords": [
    "diesis",
    "evm",
    "blockchain",
    "viem",
    "defi",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/0xDiesis/diesis-sdk.git"
  },
  "peerDependencies": {
    "viem": ">=2.0.0"
  },
  "dependencies": {
    "@diesis/contracts": "file:../diesis/contracts",
    "@noble/ciphers": "1.3.0",
    "@noble/curves": "2.2.0",
    "@noble/hashes": "2.2.0",
    "circomlibjs": "0.1.7",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.61.0",
    "@tanstack/react-query": "^5.101.1",
    "@types/node": "24.12.3",
    "@wagmi/core": "^3.5.2",
    "eslint": "^10.4.1",
    "ethers": "^6.17.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "viem": "^2.53.1",
    "wagmi": "^3.6.18",
    "vitest": "4.1.9",
    "web3": "^4.16.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
